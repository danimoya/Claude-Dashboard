{
  "name": "claude-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted GUI for Claude Code, Claude-B, and live tmux sessions — with mailbox-style task inbox, project workspace, and 2FA-gated settings.",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "npm run typecheck --workspaces",
    "prepare": "husky install",
    "docker:up": "docker-compose -f infrastructure/docker-compose.dev.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker-compose.dev.yml down",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:seed": "npm run seed --workspace=backend"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
